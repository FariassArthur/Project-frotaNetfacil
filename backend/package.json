{
  "name": "gestaofrota-backend",
  "private": true,
  "version": "1.1.0",
  "description": "API REST + SQLite + uploads para GestaoFrota",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pg:init": "bash scripts/init-pg-data.sh",
    "pg:start": "pg_ctl -D pgdata -l pgdata/pg.log start",
    "pg:stop": "pg_ctl -D pgdata stop",
    "pg:status": "pg_ctl -D pgdata status",
    "start:pg": "bash scripts/init-pg-data.sh && node src/server.js",
    "setup:nginx": "bash scripts/setup-nginx.sh",
    "setup:full": "bash scripts/init-pg-data.sh && bash scripts/setup-nginx.sh && node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "morgan": "^1.10.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
